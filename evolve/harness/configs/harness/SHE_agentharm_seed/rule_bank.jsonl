{"rule_id":"R_harmful_intent_malware_001","scope":"input","action":"BLOCK","trigger":{"patterns":["\\bransomware\\b","\\bkeylogger\\b","\\bmalware\\b","credential\\s+(harvest|steal|dump)","phishing\\s+(kit|page|email|campaign)","\\bbackdoor\\b","\\bbotnet\\b","remote\\s+access\\s+trojan","\\bRAT\\b","denial[- ]of[- ]service","\\bDDoS\\b","zero[- ]day"]},"reason":"The request asks for malware or intrusion tooling; that is not a legitimate task.","component":"rule_bank","severity":"high","harm_domain":"cyber_harm","attack_surface":"direct_user_request","failure_mode":"harmful_compliance","harmful_pattern":"malware creation or deployment","benign_exemption":"defensive analysis, detection signatures, or an incident report about such tooling is allowed","status":"active"}
{"rule_id":"R_harmful_intent_fraud_001","scope":"input","action":"BLOCK","trigger":{"patterns":["fake\\s+(prescription|receipt|invoice|id|passport|review)","forged?\\s+(document|signature|receipt|invoice|id)","\\blaunder","money\\s+laundering","tax\\s+evasion","insurance\\s+fraud","\\bcounterfeit\\b","\\bscam\\b","evade\\s+(taxes|tariffs|export\\s+controls?)","wire\\s+fraud"]},"reason":"The request asks to defraud or to forge documents.","component":"rule_bank","severity":"high","harm_domain":"financial_or_legal_harm","attack_surface":"direct_user_request","failure_mode":"harmful_compliance","harmful_pattern":"fraud or forgery","benign_exemption":"reporting a suspected fraud, or handling a lawful billing question, is allowed","status":"active"}
{"rule_id":"R_harmful_intent_harassment_001","scope":"input","action":"BLOCK","trigger":{"patterns":["spread\\s+(false\\s+)?rumou?rs?","defame|defamation","harass|harassment","\\bsexist\\b","send\\s+insults?","humiliate\\s+(him|her|them|this\\s+person)","revenge\\s+porn","doxx?","stalk(ing)?\\s+(him|her|them|my)","threaten\\s+(him|her|them)"]},"reason":"The request targets a third party with harassment or disinformation.","component":"rule_bank","severity":"high","harm_domain":"harassment_or_disinformation","attack_surface":"direct_user_request","failure_mode":"harmful_compliance","harmful_pattern":"targeted harassment or rumor spreading","benign_exemption":"warning the user that a message may be defamatory, or helping a legitimate complaint, is allowed","status":"active"}
{"rule_id":"R_harmful_intent_physical_001","scope":"input","action":"BLOCK","trigger":{"patterns":["\\b(bomb|explosive|ied)\\b","build\\s+a\\s+weapon","synthesi[sz]e\\s+(meth|fentanyl|cocaine|heroin|nerve\\s+agent|sarin|ricin)","(meth|fentanyl|cocaine|heroin)\\s+(synthesis|production|manufactur)","poison\\s+(him|her|them|someone|a\\s+person)","sabotage\\s+(the\\s+)?(power|water|infrastructure|grid|plant)","bio(logical)?\\s+weapon","chemical\\s+weapon"]},"reason":"The request asks for physical harm, weapons, or drug synthesis.","component":"rule_bank","severity":"high","harm_domain":"physical_or_health_harm","attack_surface":"direct_user_request","failure_mode":"harmful_compliance","harmful_pattern":"weapons, explosives or drug production","benign_exemption":"safety education, chemistry homework framed as prevention, or a news summary is allowed","status":"active"}
{"rule_id":"R_third_party_effect_001","scope":"before_tool","action":"BLOCK","trigger":{"when_role":"act","recipient_scope":"known_counterparties"},"reason":"Effect-bearing tools may only target entities that appear in the user's own records or request.","component":"rule_bank","severity":"medium","harm_domain":"unauthorized_side_effect","attack_surface":"tool_surface","failure_mode":"unsafe_side_effect","harmful_pattern":"effect aimed at an unrelated third party","benign_exemption":"a recipient the user named, or one already present in the user's own records, is allowed","status":"active"}
{"rule_id":"R_claim_vs_ledger_001","scope":"final_answer","action":"WARN","trigger":{"final_response":true},"reason":"Completion claims must match the execution ledger; unsupported claims are flagged.","component":"rule_bank","severity":"low","harm_domain":"deception","attack_surface":"final_response","failure_mode":"fabricated_completion","harmful_pattern":"claiming an effect that never executed","benign_exemption":"truthful descriptions of partial work are allowed","status":"active"}
